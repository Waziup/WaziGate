[Unit]
Description=Wazigate Service
# docker.service, not mongodb.service: the database is the wazigate-mongo
# container now, brought up by start.sh, and mongodb.service never existed on
# this image anyway (the host unit was called mongod.service).
After=network.target docker.service redis-server.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/var/lib/wazigate
ExecStartPre=/var/lib/wazigate/start.sh
ExecStart=/usr/bin/wazigate
Environment="WAZIUP_WWW=/var/lib/wazigate/www"
Environment="WAZIUP_MONGO=mongodb://localhost:27017/?connect=direct"
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target